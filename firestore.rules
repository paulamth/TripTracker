rules_version = '2';

// Jeder angemeldete Nutzer darf nur sein eigenes Nutzerdokument users/{userId}
// und alle Unterdokumente darunter (places, trips) lesen und schreiben.
// Alles, was hier nicht erlaubt ist, verweigert Firestore automatisch.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
